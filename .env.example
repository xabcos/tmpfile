# API process. Relative UPLOAD_DIR paths are resolved from api/ when using make run.
LISTEN_ADDR=127.0.0.1:8080
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=268435456
FILE_EXPIRATION=36h
CLEANUP_INTERVAL=18h
MAX_DOWNLOAD_COUNT=0
IMAGE_MAX_DOWNLOAD_COUNT=0

# Public API/download origin used in direct_link values.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Optional Bearer key. Never put this value into committed Pages assets.
API_KEY=

# Optional persistent metadata backend.
REDIS_ADDR=
REDIS_DB=0
RUST_LOG=info
